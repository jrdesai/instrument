# ── Generated TypeScript (ts-rs + tauri-specta) ───────
# src/bindings/*.ts are committed — deterministic, needed for IDE type resolution on fresh clone.
# src-core/instrument-core/bindings/ is the intermediate ts-rs output directory — not committed.
src-core/instrument-core/bindings/

# ── Node ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Rust build output ────────────────────────────────
target/
src-core/target/
src-tauri/target/

# ── WASM build output ────────────────────────────────
# Built by CI (build-and-deploy-web job) — not committed. Run pnpm run build:wasm locally for dev:web.
public/wasm-pkg/

# ── Logs ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment ───────────────────────────────────────
.env
.env.local
.env.*.local

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Tauri ─────────────────────────────────────────────
src-tauri/target/
src-tauri/WixTools/
src-tauri/binaries/

# ── pnpm ──────────────────────────────────────────────
.pnpm-store/

# ── WASM (src/ copy) ──────────────────────────────────
src/wasm-pkg/

# ── Cursor ────────────────────────────────────────────
.cursor/*
!.cursor/rules/
# Local temp specs
temp/

# MCP server config (contains tokens, machine-specific)
.mcp.json

# Claude Code local IDE config (machine-specific launch configurations)
.claude/launch.json
