{
  "name": "instrument",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "node scripts/tauri-build.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:wasm": "wasm-pack build src-core/instrument-web --target web --out-dir ../../public/wasm-pkg",
    "build:web": "pnpm run build:wasm && vite build --mode web",
    "build:cli-sidecar": "node scripts/build-cli-sidecar.js",
    "build:cli": "cargo build --release --manifest-path src-core/Cargo.toml -p instrument-cli",
    "install:cli": "cargo install --path src-core/instrument-cli --force",
    "test:rust": "cargo test --manifest-path src-core/Cargo.toml",
    "test:rust:core": "cargo test --manifest-path src-core/Cargo.toml -p instrument-core",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:all": "pnpm run test:rust && pnpm run test:ts",
    "lint": "eslint src/",
    "gen:types": "cargo run --manifest-path src-core/Cargo.toml -p instrument-core --bin export_types --features ts-export",
    "typecheck": "pnpm run gen:types && tsc --noEmit",
    "check:pure": "grep -r 'std::fs\\|use tauri\\|use tokio' src-core/instrument-core/src/ --include='*.rs' --exclude-dir=bin && echo 'PURITY VIOLATION' || echo 'instrument-core is pure'",
    "check:commands": "python3 .claude/check-commands.py",
    "check:wasm": "python3 .claude/check-wasm.py",
    "gen:og-image": "node scripts/generate-og-image.mjs",
    "gen:pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "immer": "^11.2.9",
    "marked": "^18.1.2",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
